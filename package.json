{
  "name": "smart-solutions-erp",
  "version": "1.0.0",
  "description": "Smart Solutions ERP",
  "main": "electron/main.js",
  "author": "Smart Solutions",
  "scripts": {
    "electron": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/filesystem": "^5.2.0",
    "@capacitor/share": "^5.0.7"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0"
  },
  "build": {
    "appId": "com.smartsolutions.erp",
    "productName": "Smart Solutions ERP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}